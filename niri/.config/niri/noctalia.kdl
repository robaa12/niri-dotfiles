layout {

    focus-ring {
        active-color   "#b0c7f3"
        inactive-color "#121316"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#b0c7f3"
        inactive-color "#121316"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#b0c7f3"
        inactive-color "#30476c"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#b0c7f380"
    }
}

recent-windows {
    highlight {
        active-color "#b0c7f3"
        urgent-color "#ffb4ab"
    }
}
